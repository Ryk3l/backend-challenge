{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "types": ["bun"],

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // NestJS: decoradores de parâmetro (@Body, @Inject) — o Bun os honra a
    // partir do tsconfig (sem emitDecoratorMetadata, por isso DI explícita)
    "experimentalDecorators": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,

    // Toda função precisa retornar valor em todos os caminhos de execução,
    // evitando retornos implícitos de undefined em funções de domínio
    "noImplicitReturns": true
  }
}
